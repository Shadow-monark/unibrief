# UniBrief works out of the box even with NO API key via its built-in official record engine.
# To enable full LLM reasoning (+ image/scan OCR for vision providers), add ANY ONE (or multiple) below:

# Option 1: Universal OpenAI-compatible or auto-detected key (Groq gsk_*, Gemini AIza*, OpenAI sk-*, OpenRouter sk-or-*, Anthropic sk-ant-*)
# AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Option 2: Provider-specific keys (automatic failover if multiple are set)
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# GROQ_API_KEY=your_groq_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# DEEPSEEK_API_KEY=your_deepseek_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# CEREBRAS_API_KEY=your_cerebras_key_here
# TOGETHER_API_KEY=your_together_key_here
# XAI_API_KEY=your_xai_key_here
